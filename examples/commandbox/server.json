{
  "name": "bx-jruby-rack-starter",
  "web": {
    "webroot": "public",
    "http": {
      "port": 8080
    },
    "directoryBrowsing": false,
    "welcomeFiles": "index.bxm,index.html",
    "servletPassPredicate": "true"
  },
  "app": {
    "cfengine": "boxlang@1.18.6+62",
    "libDirs": "modules/bx-jruby-rack/gateway",
    "webXMLOverride": "config/gateway.xml"
  },
  "jvm": {
    "javaVersion": "openjdk21_jre",
    "heapSize": 1024
  },
  "openBrowser": false,
  "trayEnable": false
}
