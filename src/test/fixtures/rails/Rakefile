require_relative 'config/application'
Rails.application.load_tasks

task :fixture_failure do
  raise 'intentional task failure'
end

task :fixture_args, [:first, :second] do |_, args|
  puts "#{args[:first]}|#{args[:second]}"
end

task :fixture_exit do
  exit 7
end

task fixture_transaction: :environment do
  original = Note.count
  Note.transaction do
    Note.create!(text: 'rolled back')
    raise ActiveRecord::Rollback
  end
  raise 'rollback did not restore row count' unless Note.count == original
  puts 'transaction rolled back'
end
