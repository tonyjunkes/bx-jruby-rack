/** Native entry point for JRubyRack; Java owns runtime execution. */
class {
    property name="moduleRecord";

    /** Validates public arguments and resolves this activation's Java bridge. */
    function invoke(required struct config) {
        if (!structKeyExists(variables, "bridge")) {
            variables.bridge = createObject(
                type = "java",
                className = "modules.bxjrubyrack.RackRuntime",
                classLoader = moduleRecord.getModuleClassLoader().toClassLoader()
            );
        }

        return variables.bridge.create(getBoxContext().getParent(), arguments.config);
    }
}
